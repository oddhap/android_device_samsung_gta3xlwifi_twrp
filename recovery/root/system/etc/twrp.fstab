# SPDX-License-Identifier: Apache-2.0
# TWRP fstab syntax: mount-point, filesystem, block-device, flags.
# Keep the ramdisk's /etc -> /system/etc symlink intact.
/boot           emmc /dev/block/platform/13500000.dwmmc0/by-name/boot flags=backup=1
/recovery       emmc /dev/block/platform/13500000.dwmmc0/by-name/recovery flags=backup=1
/misc           emmc /dev/block/platform/13500000.dwmmc0/by-name/misc
/system_root    ext4 /dev/block/platform/13500000.dwmmc0/by-name/system flags=backup=1;wipeingui;display="System"
/system_image   emmc /dev/block/platform/13500000.dwmmc0/by-name/system flags=backup=1;flashimg
/vendor         ext4 /dev/block/platform/13500000.dwmmc0/by-name/vendor flags=backup=1;display="Vendor"
/vendor_image   emmc /dev/block/platform/13500000.dwmmc0/by-name/vendor flags=backup=1;flashimg
/product        ext4 /dev/block/platform/13500000.dwmmc0/by-name/product flags=backup=1;wipeingui;display="Product"
/product_image  emmc /dev/block/platform/13500000.dwmmc0/by-name/product flags=backup=1;flashimg
/cache          ext4 /dev/block/platform/13500000.dwmmc0/by-name/cache flags=backup=1
/data           ext4 /dev/block/platform/13500000.dwmmc0/by-name/userdata flags=fileencryption=ice
/external_sd    auto /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=storage;wipeingui;removable;display="Micro SD card"
/usb-otg        vfat /dev/block/sda1 /dev/block/sda flags=storage;wipeingui;removable;display="USB OTG"
